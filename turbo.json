{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "AZURE_TRUSTED_SIGNING_SUBJECT_DN",
    "PORT",
    "VITE_WS_URL",
    "VITE_PROFILES_PUBLIC_ORIGIN",
    "VITE_DEV_SERVER_URL",
    "ELECTRON_RENDERER_PORT",
    "ZYRON_HOME",
    "ZYRON_DESKTOP_WS_URL",
    "ZYRON_BROWSER_HOST_PIPE_PATH",
    "ZYRON_BROWSER_USE_PIPE_PATH",
    "ZYRON_BROWSER_PERF",
    "ZYRON_PROVIDER_RUNTIME_IDLE_STOP_MS",
    "ZYRON_GROK_ACP_DEBUG",
    "ZYRON_WEB_SOURCEMAP",
    "ZYRON_DEV_REACT_COMPILER",
    "ZYRON_SERVER_SOURCEMAP",
    "ZYRON_DESKTOP_SOURCEMAP",
    "ZYRON_MODE",
    "ZYRON_PORT",
    "ZYRON_NO_BROWSER",
    "ZYRON_AUTH_TOKEN",
    "ZYRON_PUBLIC_URL",
    "ZYRON_ALLOW_INSECURE_REMOTE",
    "ZYRON_LOG_WS_EVENTS",
    "ZYRON_HOST",
    "ZYRON_AUTO_BOOTSTRAP_PROJECT_FROM_CWD",
    "ZYRON_ACCOUNT_URL",
    "ZYRON_ACCOUNT_PROFILE_SYNC"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "dist-electron/**", ".next/**", "!.next/cache/**"]
    },
    "transit": {
      "dependsOn": ["^transit"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": [],
      "cache": false
    },
    "typecheck:native": {
      "dependsOn": ["^typecheck:native"],
      "outputs": [],
      "cache": false
    },
    "typecheck:legacy": {
      "dependsOn": ["^typecheck:legacy"],
      "outputs": [],
      "cache": false
    },
    "test": {
      "cache": false,
      "passThroughEnv": ["TEST_DATABASE_URL"],
      "outputs": []
    }
  }
}
