{
  "name": "openbot",
  "version": "1.1.1",
  "license": "MIT",
  "private": true,
  "packageManager": "bun@1.4.3",
  "workspaces": [
    "app",
    "shared",
    "extension",
    "management-agent"
  ],
  "scripts": {
    "build": "bun run generate:app-config && bun run --filter '*' build",
    "dev": "bun run generate:app-config && bun run --filter app dev",
    "generate:app-config": "bun --env-file=.env scripts/generate-app-config.ts",
    "format": "bunx biome format --write .",
    "format:check": "bunx biome format .",
    "lint": "bunx biome lint --error-on-warnings .",
    "test": "bun test",
    "typecheck": "bun run --filter '*' typecheck",
    "api:lint": "REDOCLY_TELEMETRY=off REDOCLY_SUPPRESS_UPDATE_NOTICE=true redocly lint",
    "api:bundle": "REDOCLY_TELEMETRY=off REDOCLY_SUPPRESS_UPDATE_NOTICE=true redocly bundle api/openapi/common.yaml -o api/openapi.yaml --component-renaming-conflicts-severity error",
    "api:generate": "bun run api:bundle && orval --config app/orval.config.ts && orval --config mobile/orval.config.ts && orval --config extension/orval.config.ts",
    "api:live:diff": "bun api/asyncapi-diff.ts",
    "test:ci": "bun scripts/test-ci.ts",
    "pretest": "bun run generate:app-config",
    "test:smoke": "OPENBOT_SMOKE=1 bun test tests/smoke",
    "diagram": "bun scripts/architecture-diagram.ts",
    "setup:composio": "bun scripts/setup-composio.ts",
    "composio:smoke": "bash scripts/composio-smoke.sh",
    "mock:knowledge": "bun scripts/mock-knowledge-mcp.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@copilotkit/aimock": "1.48.0",
    "@copilotkit/runtime": "1.88.0",
    "@happy-dom/global-registrator": "^20.11.2",
    "@noble/curves": "2.4.0",
    "@redocly/cli": "2.72.1",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/router-plugin": "^1.169.0",
    "@types/bun": "^1.3.3",
    "@vitejs/plugin-react": "^6.3.0",
    "orval": "8.45.0",
    "roughjs": "^4.6.6",
    "typescript": "^5.9.3",
    "vite": "^8.1.5",
    "yaml": "^2.9.0"
  },
  "dependencies": {
    "@ag-ui/client": "^1.0.5",
    "@ag-ui/core": "^1.0.5",
    "@ag-ui/proto": "^1.0.5",
    "@base-ui/react": "^1.9.0",
    "@better-auth/sso": "^1.7.26",
    "@copilotkit/learning": "^1.90.0",
    "@copilotkit/react-core": "^1.89.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@shadcn/react": "^0.3.1",
    "@streamdown/code": "^2.0.1",
    "@streamdown/math": "^1.0.4",
    "@tabler/icons-react": "^3.52.0",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-hotkeys": "^0.27.1",
    "@tanstack/react-query": "^5.108.1",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-table": "^9.3.1",
    "@types/phoenix": "^1.6.8",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "better-auth": "^1.7.26",
    "boring-avatars": "^2.0.4",
    "canonicalize": "^5.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "diff": "^9.0.0",
    "embla-carousel-react": "^8.6.0",
    "eventsource-parser": "^4.1.3",
    "katex": "^0.19.1",
    "motion": "^14.14.0",
    "phoenix": "^1.8.17",
    "playwright-core": "1.62.1",
    "prompt-area": "^0.7.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-use-measure": "^2.1.7",
    "rxjs": "^7.8.2",
    "shadcn": "^4.23.0",
    "shell-quote": "^1.12.0",
    "streamdown": "^2.8.0",
    "tailwind-merge": "^3.7.1",
    "tailwindcss": "^4.3.5",
    "tldts": "^7.5.5",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "overrides": {
    "fast-xml-parser": "5.12.1",
    "lodash-es": "4.18.0"
  }
}
